# FastAPI (async)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_PASSWORD]@db.[HOST].supabase.co:5432/postgres

# Alembic (sync)
ALEMBIC_DATABASE_URL=postgresql+psycopg2://postgres:[YOUR_PASSWORD]@db.[HOST].supabase.co:5432/postgres

# Secret key
SECRET_KEY=[YOUR_SECRET_KEY]

# Debug mode (set to True only in development)
DEBUG=False

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database connection pool settings (optional - defaults provided)
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10

# Rate limiting settings (optional - defaults provided)
# MAX_PENDING_TRAINING_REQUESTS=10

# CORS settings (comma-separated list of origins)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Twilio SMS Verification settings
TWILIO_ACCOUNT_SID=[YOUR_TWILIO_ACCOUNT_SID]
TWILIO_AUTH_TOKEN=[YOUR_TWILIO_AUTH_TOKEN]
TWILIO_VERIFY_SERVICE_SID=[YOUR_TWILIO_VERIFY_SERVICE_SID]

# CORS - must be valid JSON
# For mobile app development, add your computer's local IP (e.g., "http://192.168.1.100:8081")
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006"]
